<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TPQ Wardatul Wathon</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
  :root{
    --paper:#FAF6EC;
    --paper-deep:#F0E8D6;
    --ink:#22221B;
    --ink-soft:#615F50;
    --ink-faint:#8B8873;
    --pine:#1F4B43;
    --pine-deep:#12332D;
    --pine-soft:#E1EAE6;
    --gold:#B4832A;
    --gold-soft:#F3E6C6;
    --brick:#A8452F;
    --brick-soft:#F5DDD5;
    --line:#DCD3B9;
    --white:#FFFFFF;
    --r-s:6px;
    --r-m:12px;
    --r-l:20px;
    --shadow:0 1px 2px rgba(18,51,45,0.06), 0 6px 20px rgba(18,51,45,0.07);
  }
  *{box-sizing:border-box;}
  body{margin:0;}
  html,body{
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter',sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{
    font-family:'Fraunces',serif;
    letter-spacing:-0.01em;
    margin:0;
  }
  button{font-family:inherit;cursor:pointer;}
  input,select,textarea{font-family:inherit;}
  a{color:inherit;}
  ::selection{background:var(--gold-soft);}

  /* ---------- pattern helpers ---------- */
  .lattice{
    background-image:
      radial-gradient(circle at 1px 1px, rgba(255,255,255,0.16) 1px, transparent 1px);
    background-size:16px 16px;
  }
  .lattice-dark{
    background-image:
      radial-gradient(circle at 1px 1px, rgba(18,51,45,0.10) 1px, transparent 1px);
    background-size:16px 16px;
  }

  /* ---------- login ---------- */
  #login-screen{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:24px;
    background:
      radial-gradient(ellipse at top left, #1a4038 0%, var(--pine-deep) 55%, #0d2622 100%);
  }
  .login-card{
    width:100%;
    max-width:400px;
    background:var(--paper);
    border-radius:var(--r-l);
    box-shadow:0 30px 60px rgba(0,0,0,0.35);
    overflow:hidden;
  }
  .login-mark{
    padding:36px 32px 28px;
    background:var(--pine-deep);
    position:relative;
    color:var(--gold-soft);
  }
  .login-mark::after{
    content:"";
    position:absolute; inset:0;
    background-image:radial-gradient(circle at 1px 1px, rgba(243,230,198,0.14) 1px, transparent 1px);
    background-size:14px 14px;
    pointer-events:none;
  }
  .login-badge{
    width:52px;height:52px;border-radius:50%;
    border:1.5px solid var(--gold);
    display:flex;align-items:center;justify-content:center;
    font-family:'Fraunces',serif;font-size:22px;color:var(--gold-soft);
    margin-bottom:16px;
    position:relative;
  }
  .login-mark h1{font-size:22px;color:#fff;font-weight:600;position:relative;line-height:1.25;}
  .login-mark p{margin:6px 0 0;font-size:13px;color:#c9d8d2;position:relative;}
  .login-body{padding:28px 32px 32px;}
  .field{margin-bottom:16px;}
  .field label{
    display:block;font-size:12.5px;color:var(--ink-soft);margin-bottom:6px;font-weight:600;
  }
  .field-static{
    padding:11px 13px;border-radius:var(--r-s);background:var(--paper-deep);
    color:var(--ink-faint);font-size:15px;border:1px solid var(--line);
  }
  .field input, .field select{
    width:100%;padding:11px 13px;border-radius:var(--r-s);
    border:1px solid var(--line);background:#fff;font-size:15px;color:var(--ink);
    outline:none;
  }
  .field input:focus, .field select:focus{border-color:var(--pine);box-shadow:0 0 0 3px var(--pine-soft);}
  .btn{
    border:none;border-radius:var(--r-s);padding:11px 18px;font-size:14.5px;font-weight:600;
    display:inline-flex;align-items:center;justify-content:center;gap:8px;
    transition:transform .06s ease, filter .15s ease;
  }
  .btn:active{transform:scale(0.98);}
  .btn-primary{background:var(--pine);color:#fff;width:100%;padding:12px;}
  .btn-primary:hover{filter:brightness(1.08);}
  .btn-gold{background:var(--gold);color:#3a2a08;}
  .btn-gold:hover{filter:brightness(1.06);}
  .btn-ghost{background:transparent;color:var(--pine);border:1px solid var(--line);}
  .btn-ghost:hover{background:var(--pine-soft);}
  .btn-danger{background:var(--brick-soft);color:var(--brick);}
  .btn-danger:hover{background:#efc9be;}
  .btn-sm{padding:7px 12px;font-size:13px;}
  .login-demo-note{
    margin-top:18px;padding:11px 13px;background:var(--gold-soft);border-radius:var(--r-s);
    font-size:12px;color:#5c4413;line-height:1.5;
  }
  .login-error{color:var(--brick);font-size:13px;margin:-6px 0 14px;display:none;}

  /* ---------- shell ---------- */
  #app-shell{display:none;min-height:100vh;}
  .topbar{
    position:sticky;top:0;z-index:20;
    background:var(--pine-deep);color:#fff;
    padding:0 20px;height:60px;
    display:flex;align-items:center;justify-content:space-between;
  }
  .topbar-left{display:flex;align-items:center;gap:12px;}
  .topbar-mark{
    width:34px;height:34px;border-radius:50%;border:1.5px solid var(--gold);
    display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;
    color:var(--gold-soft);font-size:14px;
  }
  .topbar-title{font-family:'Fraunces',serif;font-size:16.5px;font-weight:600;line-height:1.2;}
  .topbar-title small{display:block;font-family:'Inter',sans-serif;font-weight:400;font-size:11px;color:#a9bdb6;}
  .topbar-right{display:flex;align-items:center;gap:14px;}
  .topbar-user{text-align:right;font-size:13px;line-height:1.3;}
  .topbar-user b{display:block;font-size:13.5px;}
  .topbar-user span{color:#a9bdb6;font-size:11.5px;}
  .icon-btn{
    width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,0.08);
    border:none;color:#fff;display:flex;align-items:center;justify-content:center;font-size:15px;
  }
  .icon-btn:hover{background:rgba(255,255,255,0.16);}

  .shell-body{display:flex;align-items:flex-start;min-height:calc(100vh - 60px);}
  .sidebar{
    width:220px;flex-shrink:0;background:var(--pine);min-height:calc(100vh - 60px);
    padding:18px 12px;
  }
  .nav-item{
    display:flex;align-items:center;gap:11px;padding:11px 13px;border-radius:var(--r-s);
    color:#dce8e4;font-size:14px;font-weight:500;margin-bottom:3px;
  }
  .nav-item i{width:18px;text-align:center;font-size:14.5px;}
  .nav-item.active{background:rgba(255,255,255,0.12);color:#fff;}
  .nav-item:not(.active):hover{background:rgba(255,255,255,0.06);cursor:pointer;}

  .content{flex:1;padding:26px 30px 60px;max-width:1180px;}
  @media (max-width: 860px){
    .sidebar{width:64px;}
    .nav-item span{display:none;}
    .nav-item{justify-content:center;padding:12px 0;}
    .content{padding:18px 14px 50px;}
    .topbar-title small{display:none;}
  }

  /* ---------- hero / cards ---------- */
  .hero{
    background:linear-gradient(120deg, var(--pine-deep), var(--pine) 130%);
    border-radius:var(--r-l);padding:26px 28px;color:#fff;position:relative;overflow:hidden;
    margin-bottom:22px;
  }
  .hero::after{
    content:"";position:absolute;inset:0;
    background-image:radial-gradient(circle at 1px 1px, rgba(255,255,255,0.13) 1px, transparent 1px);
    background-size:16px 16px;pointer-events:none;
  }
  .hero-eyebrow{position:relative;font-size:12.5px;color:#b9cec7;margin-bottom:6px;}
  .hero h2{position:relative;font-size:23px;font-weight:600;color:#fff;}
  .hero p{position:relative;margin:8px 0 0;font-size:13.5px;color:#c9d8d2;max-width:520px;line-height:1.55;}

  .grid{display:grid;gap:16px;}
  .grid-2{grid-template-columns:1fr 1fr;}
  .grid-3{grid-template-columns:repeat(3,1fr);}
  .grid-4{grid-template-columns:repeat(4,1fr);}
  @media (max-width:860px){.grid-2,.grid-3,.grid-4{grid-template-columns:1fr;}}

  .panel{
    background:#fff;border:1px solid var(--line);border-radius:var(--r-m);
    padding:20px 20px 22px;
  }
  .panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;gap:10px;flex-wrap:wrap;}
  .panel-head h3{font-size:16.5px;font-weight:600;}
  .panel-head .sub{font-size:12.5px;color:var(--ink-faint);margin-top:2px;}

  .stat-card{
    background:#fff;border:1px solid var(--line);border-radius:var(--r-m);
    padding:16px 18px;border-left:4px solid var(--pine);
  }
  .stat-card.gold{border-left-color:var(--gold);}
  .stat-card.brick{border-left-color:var(--brick);}
  .stat-card .stat-label{font-size:12px;color:var(--ink-faint);font-weight:600;}
  .stat-card .stat-value{font-family:'Fraunces',serif;font-size:26px;margin-top:4px;}
  .stat-card .stat-note{font-size:11.5px;color:var(--ink-faint);margin-top:2px;}

  .person-row{display:flex;align-items:center;gap:12px;}
  .avatar{
    width:44px;height:44px;border-radius:50%;background:var(--pine-soft);color:var(--pine);
    display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;flex-shrink:0;
  }
  .avatar.small{width:32px;height:32px;font-size:12.5px;}
  .avatar.gold{background:var(--gold-soft);color:#7a5713;}

  .badge{
    display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:100px;
    font-size:11.5px;font-weight:600;
  }
  .badge-green{background:var(--pine-soft);color:var(--pine);}
  .badge-gold{background:var(--gold-soft);color:#7a5713;}
  .badge-brick{background:var(--brick-soft);color:var(--brick);}

  .announce-item{
    padding:12px 0;border-bottom:1px solid var(--line);
  }
  .announce-item:last-child{border-bottom:none;}
  .announce-item .a-title{font-weight:600;font-size:14px;}
  .announce-item .a-date{font-size:11.5px;color:var(--ink-faint);margin-top:1px;}
  .announce-item .a-body{font-size:13px;color:var(--ink-soft);margin-top:5px;line-height:1.5;}

  table{width:100%;border-collapse:collapse;font-size:13.5px;}
  thead th{
    text-align:left;font-size:11.5px;color:var(--ink-faint);font-weight:700;
    padding:0 10px 9px;border-bottom:1.5px solid var(--line);white-space:nowrap;
  }
  tbody td{padding:11px 10px;border-bottom:1px solid var(--line);vertical-align:middle;}
  tbody tr:last-child td{border-bottom:none;}
  .table-scroll{overflow-x:auto;}
  .action-icon{
    width:32px;height:32px;border-radius:8px;border:1px solid var(--line);background:#fff;
    display:inline-flex;align-items:center;justify-content:center;color:var(--pine);font-size:13.5px;
    margin-right:5px;
  }
  .action-icon:hover{background:var(--pine-soft);}
  .action-icon.gold{color:#7a5713;}
  .action-icon.gold:hover{background:var(--gold-soft);}
  .action-icon.brick{color:var(--brick);}
  .action-icon.brick:hover{background:var(--brick-soft);}

  /* ---------- modal ---------- */
  .modal-backdrop{
    display:none;position:fixed;inset:0;background:rgba(18,30,27,0.55);
    z-index:100;align-items:flex-start;justify-content:center;padding:36px 16px;overflow-y:auto;
  }
  .modal-backdrop.open{display:flex;}
  .modal-box{
    background:var(--paper);border-radius:var(--r-l);max-width:560px;width:100%;
    box-shadow:0 30px 60px rgba(0,0,0,0.35);overflow:hidden;
  }
  .modal-box.wide{max-width:680px;}
  .modal-head{
    padding:18px 22px;background:var(--pine-deep);color:#fff;
    display:flex;align-items:center;justify-content:space-between;
  }
  .modal-head h3{font-size:16px;font-weight:600;color:#fff;}
  .modal-head .sub{font-size:12px;color:#a9bdb6;margin-top:2px;}
  .modal-close{background:rgba(255,255,255,0.1);border:none;color:#fff;width:30px;height:30px;border-radius:50%;}
  .modal-body{padding:22px;max-height:70vh;overflow-y:auto;}
  .modal-foot{padding:14px 22px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:10px;}

  .tabs{display:flex;gap:6px;margin-bottom:16px;border-bottom:1.5px solid var(--line);}
  .tab-btn{
    background:none;border:none;padding:9px 4px;margin-right:14px;font-size:13.5px;font-weight:600;
    color:var(--ink-faint);border-bottom:2.5px solid transparent;margin-bottom:-1.5px;
  }
  .tab-btn.active{color:var(--pine);border-bottom-color:var(--pine);}

  .page-viewer{
    background:var(--pine-deep);border-radius:var(--r-m);padding:26px;text-align:center;color:#fff;
    position:relative;overflow:hidden;margin-bottom:16px;
  }
  .page-viewer::after{
    content:"";position:absolute;inset:0;
    background-image:radial-gradient(circle at 1px 1px, rgba(255,255,255,0.1) 1px, transparent 1px);
    background-size:14px 14px;
  }
  .page-viewer .pv-book{position:relative;font-size:11.5px;color:#a9bdb6;letter-spacing:.02em;}
  .page-viewer .pv-page{position:relative;font-family:'Fraunces',serif;font-size:46px;margin:6px 0 2px;color:#fff;}
  .page-viewer .pv-note{position:relative;font-size:11.5px;color:#c9d8d2;}

  .form-row{margin-bottom:14px;}
  .form-row label{display:block;font-size:12.5px;font-weight:600;color:var(--ink-soft);margin-bottom:5px;}
  .form-row input, .form-row select, .form-row textarea{
    width:100%;padding:10px 12px;border-radius:var(--r-s);border:1px solid var(--line);
    background:#fff;font-size:14px;outline:none;
  }
  .form-row input:focus, .form-row select:focus, .form-row textarea:focus{border-color:var(--pine);box-shadow:0 0 0 3px var(--pine-soft);}
  .form-row textarea{resize:vertical;min-height:70px;}
  .two-col{display:grid;grid-template-columns:1fr 1fr;gap:12px;}

  .mic-box{
    display:flex;align-items:center;gap:14px;background:var(--paper-deep);border-radius:var(--r-m);
    padding:14px 16px;margin-bottom:10px;
  }
  .mic-circle{
    width:48px;height:48px;border-radius:50%;background:var(--brick);color:#fff;border:none;
    display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0;
  }
  .mic-circle.recording{animation:pulse 1.1s infinite;}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(168,69,47,0.5);}70%{box-shadow:0 0 0 12px rgba(168,69,47,0);}100%{box-shadow:0 0 0 0 rgba(168,69,47,0);}}
  .wave{display:flex;align-items:center;gap:3px;height:26px;flex:1;}
  .wave span{width:3px;background:var(--pine);border-radius:2px;height:6px;}
  .mic-time{font-variant-numeric:tabular-nums;font-size:13px;color:var(--ink-soft);}

  .voice-msg{
    display:flex;align-items:center;gap:10px;background:var(--pine-soft);border-radius:100px;
    padding:7px 13px 7px 7px;font-size:12.5px;color:var(--pine);width:fit-content;
  }
  .voice-msg .vm-play{width:24px;height:24px;border-radius:50%;background:var(--pine);color:#fff;border:none;display:flex;align-items:center;justify-content:center;font-size:10px;}

  .qr-box{
    width:170px;height:170px;margin:0 auto 14px;background:#fff;border-radius:var(--r-s);
    padding:10px;border:1px solid var(--line);
  }
  .qr-box img{width:100%;height:100%;object-fit:contain;}

  .upload-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;}
  .upload-current{
    font-size:12px;color:var(--ink-faint);background:var(--paper-deep);border:1px solid var(--line);
    border-radius:100px;padding:5px 12px;
  }
  .file-input{
    font-size:12.5px;padding:8px 10px;border:1px dashed var(--line);border-radius:var(--r-s);
    background:#fff;width:100%;max-width:220px;
  }
  .upload-preview-row{display:flex;align-items:center;gap:14px;margin-top:6px;}
  .logo-preview{
    width:56px;height:56px;border-radius:50%;background:var(--pine-deep);color:var(--gold-soft);
    display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-size:18px;
    flex-shrink:0;overflow:hidden;border:1.5px solid var(--gold);
  }
  .logo-preview img{width:100%;height:100%;object-fit:cover;}
  .qris-preview{
    width:56px;height:56px;border-radius:var(--r-s);background:var(--paper-deep);color:var(--ink-faint);
    display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;overflow:hidden;
    border:1px solid var(--line);
  }
  .qris-preview img{width:100%;height:100%;object-fit:contain;}
  .setting-label{display:block;font-size:12.5px;font-weight:600;color:var(--ink-soft);margin-bottom:6px;}

  /* ---------- accessibility & polish ---------- */
  :focus-visible{outline:2px solid var(--gold);outline-offset:2px;border-radius:4px;}
  @media (prefers-reduced-motion: reduce){
    .mic-circle.recording{animation:none;box-shadow:0 0 0 4px rgba(168,69,47,0.35);}
    *{scroll-behavior:auto !important;}
  }
  html{scroll-behavior:smooth;}
  ::-webkit-scrollbar{width:9px;height:9px;}
  ::-webkit-scrollbar-thumb{background:var(--line);border-radius:100px;}
  ::-webkit-scrollbar-track{background:transparent;}

  .empty-note{padding:24px;text-align:center;color:var(--ink-faint);font-size:13px;}

  .toast{
    position:fixed;bottom:22px;left:50%;transform:translateX(-50%);
    background:var(--pine-deep);color:#fff;padding:12px 20px;border-radius:100px;font-size:13.5px;
    box-shadow:0 10px 30px rgba(0,0,0,0.25);z-index:200;display:none;align-items:center;gap:8px;
  }
  .toast.show{display:flex;}
  .toast i{color:var(--gold-soft);}
</style>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-storage-compat.js"></script>
</head>
<body>

<!-- ======================= LOGIN ======================= -->
<div id="login-screen">
  <div class="login-card">
    <div class="login-mark">
      <div class="login-badge" id="login-badge-el">TW</div>
      <h1>TPQ Wardatul Wathon</h1>
      <p>Tukum Kidul, Lumajang — portal pembelajaran santri</p>
    </div>
    <div class="login-body">
      <div class="field">
        <label>Akun tersimpan pada perangkat ini</label>
        <div class="field-static" id="account-display">Belum ada akun perangkat</div><input type="text" id="device-username" placeholder="Masukkan username akun" autocomplete="username" style="display:none;margin-top:8px;">
      </div>
      <div class="field">
        <label>Kata sandi</label>
        <input type="password" id="login-password" placeholder="Masukkan kata sandi" autocomplete="current-password">
      </div>
      <div class="login-error" id="login-error">Kata sandi salah. Coba lagi.</div>
      <button class="btn btn-primary" onclick="doLogin()">Masuk</button>
      <div class="login-demo-note" id="login-note">Username akun ditetapkan admin dan disimpan pada perangkat. Pengguna cukup memasukkan kata sandi.</div>
    </div>
  </div>
</div>

<!-- ======================= APP SHELL ======================= -->
<div id="app-shell">
  <div class="topbar">
    <div class="topbar-left">
      <div class="topbar-mark" id="topbar-mark-el">TW</div>
      <div class="topbar-title">TPQ Wardatul Wathon<small id="topbar-role-label">Portal</small></div>
    </div>
    <div class="topbar-right">
      <div class="topbar-user"><b id="topbar-username">-</b><span id="topbar-usersub">-</span></div>
      <button class="icon-btn" title="Keluar" onclick="doLogout()"><i class="fa-solid fa-right-from-bracket"></i></button>
    </div>
  </div>
  <div class="shell-body">
    <div class="sidebar" id="sidebar"></div>
    <div class="content" id="content"></div>
  </div>
</div>

<!-- ======================= MODAL ======================= -->
<div class="modal-backdrop" id="modal-backdrop">
  <div class="modal-box" id="modal-box"></div>
</div>

<div class="toast" id="toast"><i class="fa-solid fa-circle-check"></i><span id="toast-text"></span></div>

<script>
/* ============================================================
   MOCK DATABASE
   ============================================================ */
const LEGACY_DB = {
  jilid: [
    { id:'j1', nama:'Jilid 1', ustadzahId:'u2', bukuBacaan:'Iqro Jilid 1.pdf', bukuHafalan:'Juz Amma (Pemula).pdf' },
