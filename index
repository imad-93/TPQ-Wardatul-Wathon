async function simpanJilid(id){
  const nama=$("f-j-nama").value.trim();
  const ustadzahId=$("f-j-ustadzah").value||null;
  if(!nama){showToast("Nama jilid wajib diisi");return}
  let bacaan=ui.tempJilidFiles?.bacaan||"";
  let hafalan=ui.tempJilidFiles?.hafalan||"";
  if(bacaan instanceof File)bacaan=await fbUpload(bacaan,"buku");
  if(hafalan instanceof File)hafalan=await fbUpload(hafalan,"buku");
  const jid=id||fbId();
  await fbWrite("jilid",jid,{nama,ustadzahId,bukuBacaan:bacaan,bukuHafalan:hafalan});
  if(ustadzahId)await fbWrite("ustadzah",ustadzahId,{jilidId:jid});
  closeModal();
  showToast("Jilid disimpan");
}

async function fbUpload(file,folder){
  const path=`${folder}/${Date.now()}_${fbId()}_${file.name}`;
  const snapshot=await fbStorage.ref(path).put(file);
  return await snapshot.ref.getDownloadURL();
}

