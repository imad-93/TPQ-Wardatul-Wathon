};

const $=id=>document.getElementById(id);
function clearLoginError(){const e=$("login-error");if(e)e.style.display="none";}
function showLoginError(msg){const e=$("login-error");if(e){e.textContent=msg;e.style.display="block";}}

let fbApp=null,fbAuth=null,fbDb=null,fbStorage=null;
let fbUnsubs=[];
let fbReady=false;

function firebaseConfigured(){
  return Object.values(FIREBASE_CONFIG).every(v=>v&&String(v).indexOf("ISI_")!==0);
}

function fbDate(){
  return new Date().toISOString().slice(0,10);
}

function fbUsernameEmail(username){
  return String(username||"").trim().toLowerCase()+"@tpq.local";
}

function fbId(){
  return "id_"+crypto.randomUUID();
}

function fbObject(docSnap){
  return {id:docSnap.id,...docSnap.data()};
}

function fbClearListeners(){
  fbUnsubs.forEach(u=>{try{u()}catch(e){}});
  fbUnsubs=[];
}

function fbRefresh(){
  if(!session)return;
  try{
    renderSidebar();
    if(session.role==="wali")renderWaliDashboard();
    if(session.role==="ustadzah")renderUstadzahDashboard();
    if(session.role==="admin")renderAdmin();
  }catch(e){console.error(e)}
}

function fbListen(name,target){
  const u=fbDb.collection(name).onSnapshot(snap=>{
    DB[target]=snap.docs.map(fbObject);
    fbRefresh();
  },e=>console.error("Firestore listener:",name,e));
  fbUnsubs.push(u);
}

function fbListenNested(name,target){
  const u=fbDb.collection(name).onSnapshot(snap=>{
    DB[target]={};
    snap.docs.forEach(d=>DB[target][d.id]=d.data());
    fbRefresh();
  },e=>console.error("Firestore listener:",name,e));
  fbUnsubs.push(u);
}

function fbListenFinance(){
  const u=fbDb.collection("keuangan").onSnapshot(snap=>{
    DB.keuangan={};
    snap.docs.forEach(d=>DB.keuangan[d.id]=d.data().items||[]);
    fbRefresh();
  },e=>console.error("Firestore listener: keuangan",e));
  fbUnsubs.push(u);
}

function fbListenSettings(){
  const u=fbDb.collection("settings").doc("main").onSnapshot(snap=>{
    if(snap.exists)DB.settings={...DB.settings,...snap.data()};
    applyBranding();
    fbRefresh();
  },e=>console.error("Firestore listener: settings",e));
  fbUnsubs.push(u);
}

function fbStartRealtime(){
  fbClearListeners();
  fbListen("jilid","jilid");
  fbListen("ustadzah","ustadzah");
  fbListen("santri","santri");
  fbListen("wali","wali");
  fbListen("admin","admin");
  fbListen("pengumuman","pengumuman");
  fbListenNested("riwayat","riwayat");
  fbListenFinance();
  fbListenSettings();
}

function fbProfile(uid){
  return fbDb.collection("users").doc(uid).get().then(snap=>{
    if(!snap.exists)throw new Error("Profil pengguna belum dibuat di Firestore.");
    return {id:uid,...snap.data()};
  });
}

function fbShowLogin(){
  $("login-screen").style.display="flex";
  $("app-shell").style.display="none";
  const username=localStorage.getItem("tpq_device_username")||"";
  const account=$("account-display");
  const usernameInput=$("device-username");
  if(username){
    if(account)account.textContent=username;
    if(usernameInput)usernameInput.style.display="none";
    $("login-password").focus();
  }else{
    if(account)account.textContent="Belum ada akun perangkat";
    if(usernameInput){usernameInput.style.display="block";usernameInput.value="";}
  }
  const note=$("login-note");
  if(note)note.textContent=username?"Masukkan kata sandi akun "+username+".":"Masukkan username akun yang diberikan admin, lalu kata sandi.";
}

function fbSetSession(profile){
  session={role:profile.role,id:profile.id,nama:profile.nama,username:profile.username};
  localStorage.setItem("tpq_device_username",profile.username||"");
  localStorage.setItem("tpq_session_uid",profile.id);
  $("login-screen").style.display="none";
  $("app-shell").style.display="block";
  $("topbar-role-label").textContent=profile.role==="wali"?"Portal Wali":profile.role==="ustadzah"?"Portal Ustadzah":"Portal Admin";
  $("topbar-username").textContent=profile.nama||profile.username||"-";
  $("topbar-usersub").textContent="@"+(profile.username||"-");
  renderSidebar();
}

async function doLogin(){
  clearLoginError();
  if(!fbReady){
    showLoginError("Firebase belum siap. Periksa koneksi internet dan konfigurasi Firebase.");
    return;
  }
  let username=localStorage.getItem("tpq_device_username")||"";
  if(!username){
    username=$("device-username")?.value.trim().toLowerCase()||"";
    if(!username){
      showLoginError("Username wajib diisi pada perangkat ini.");
      return;
    }
    if(!/^[a-z0-9._-]{3,50}$/.test(username)){
      showLoginError("Format username tidak valid.");
      return;
    }
    localStorage.setItem("tpq_device_username",username);
  }
  const pass=$("login-password").value;
  if(!pass){
    showLoginError("Kata sandi wajib diisi.");
    return;
  }
  if(!pass){
    showLoginError("Kata sandi wajib diisi.");
    return;
  }
  try{
    const cred=await fbAuth.signInWithEmailAndPassword(fbUsernameEmail(username),pass);
    const profile=await fbProfile(cred.user.uid);
    if(!profile.role)throw new Error("Role pengguna belum diatur.");
    if(String(profile.username||"").toLowerCase()!==username.toLowerCase())throw new Error("Username akun tidak sesuai.");
    fbSetSession(profile);
    fbStartRealtime();
    fbRefresh();
  }catch(e){
    console.error(e);
    showLoginError(e.code==="auth/invalid-credential"||e.code==="auth/wrong-password"||e.code==="auth/user-not-found"?"Kata sandi atau akun tidak valid.":e.message||"Login gagal.");
  }
}

async function doLogout(){
  fbClearListeners();
  session=null;
  localStorage.removeItem("tpq_session_uid");
  if(fbAuth)await fbAuth.signOut();
  $("app-shell").style.display="none";
  $("login-screen").style.display="flex";
  $("login-password").value="";
  fbShowLogin();
}

function onPickAccount(){
  const el=$("device-username");
  if(el&&el.value.trim()){
    localStorage.setItem("tpq_device_username",el.value.trim().toLowerCase());
    fbShowLogin();
  }
}

function findWali(id){
  return DB.wali.find(w=>w.id===id)||DB.wali.find(w=>w.uid===id)||DB.wali.find(w=>w.username===session?.username);
}

function findUstadzah(id){
  return DB.ustadzah.find(u=>u.id===id)||DB.ustadzah.find(u=>u.uid===id)||DB.ustadzah.find(u=>u.username===session?.username);
}

function findAdminName(){
  return DB.admin.find(a=>a.id===session?.id)?.nama||DB.admin.find(a=>a.uid===session?.id)?.nama||session?.nama||"Admin TPQ";
}

async function fbWrite(collectionName,id,data){
  const payload={...data,updatedAt:firebase.firestore.FieldValue.serverTimestamp()};
  await fbDb.collection(collectionName).doc(id).set(payload,{merge:true});
}

async function fbDelete(collectionName,id){
  await fbDb.collection(collectionName).doc(id).delete();
}

async function saveRiwayat(sid,data){
  const current=DB.riwayat[sid]||{bacaan:[],hafalan:[]};
  current[data.jenis]=data.list;
  await fbWrite("riwayat",sid,current);
}

async function markHalaman(sid,jenis){
  const val=parseInt($("halaman-input").value)||1;
  const current=DB.riwayat[sid]||{bacaan:[],hafalan:[]};
  const list=[...(current[jenis]||[])];
  list.unshift({halaman:val,status:"naik",pesan:"Halaman ditandai oleh ustadzah.",pesanTipe:"teks",tanggal:fbDate()});
  await saveRiwayat(sid,{jenis,list});
  showToast("Halaman terakhir tersimpan");
}

async function addRiwayat(sid,jenis,status){
  const current=DB.riwayat[sid]||{bacaan:[],hafalan:[]};
  const list=[...(current[jenis]||[])];
  const last=list[0]||{halaman:1};
  list.unshift({halaman:last.halaman,status,pesan:status==="naik"?"Alhamdulillah, bacaan sudah baik.":"Perlu diulang, latihan sedikit lagi ya.",pesanTipe:"teks",tanggal:fbDate()});
  await saveRiwayat(sid,{jenis,list});
  showToast(status==="naik"?"Ditandai naik":"Ditandai mengulang");
}

async function sendPesan(sid,jenis){
  const teks=$("pesan-teks")?.value.trim();
  const current=DB.riwayat[sid]||{bacaan:[],hafalan:[]};
  const list=[...(current[jenis]||[])];
  const last=list[0]||{halaman:1,status:"naik"};
  if(ui.recordSeconds>0){
    list.unshift({halaman:last.halaman,status:last.status||"naik",pesan:`Pesan suara (${fmtTime(ui.recordSeconds)})`,pesanTipe:"suara",tanggal:fbDate()});
  }else if(teks){
    list.unshift({halaman:last.halaman,status:last.status||"naik",pesan:teks,pesanTipe:"teks",tanggal:fbDate()});
  }else{
    showToast("Tulis pesan atau rekam pesan suara terlebih dahulu");
    return;
  }
  await saveRiwayat(sid,{jenis,list});
  ui.recording=false;
  ui.recordSeconds=0;
  clearInterval(ui.recordTimer);
  ui.recordTimer=null;
  showToast("Pesan tersimpan realtime");
}

async function markLunas(sid,kid){
  const list=[...(DB.keuangan[sid]||[])];
  const item=list.find(k=>k.id===kid);
  if(!item)return;
  item.status="lunas";
  item.metode="Tunai";
  item.tanggal=fbDate();
  await fbWrite("keuangan",sid,{items:list});
  showToast("Ditandai lunas");
}

async function tambahSetoran(sid){
  const d=new Date();
  const bulan=["Januari","Februari","Maret","April","Mei","Juni","Juli","Agustus","September","Oktober","November","Desember"];
  const list=[...(DB.keuangan[sid]||[])];
  list.push({id:fbId(),jenis:"Tabungan",label:`Tabungan ${bulan[d.getMonth()]} ${d.getFullYear()}`,nominal:Number(DB.settings.tabungan.minSetor||0),status:"belum",metode:"-",tanggal:"-"});
  await fbWrite("keuangan",sid,{items:list});
  showToast("Catatan tabungan ditambahkan");
}

async function simpanSantri(id){
  const nama=$("f-nama").value.trim();
  const jilidId=$("f-jilid").value;
  const waliNama=$("f-wali-nama").value.trim();
  const waliHp=$("f-wali-hp").value.trim();
  if(!nama||!waliNama){showToast("Nama santri dan wali wajib diisi");return}
  if(id){
    const s=findSantri(id);
    const w=findWali(s?.waliId);
    await fbWrite("santri",id,{nama,jilidId});
    if(w)await fbWrite("wali",w.id,{nama:waliNama,hp:waliHp});
    showToast("Data santri diperbarui");
  }else{
    const sid=fbId();
    const wid=fbId();
    const uname=($("f-wali-username")?.value.trim()||"wali."+nama.split(" ")[0].toLowerCase());
    await fbWrite("wali",wid,{nama:waliNama,username:uname,hp:waliHp,santriId:sid,role:"wali"});
    await fbWrite("santri",sid,{nama,jilidId,waliId:wid});
    await fbWrite("keuangan",sid,{items:[]});
    await fbWrite("riwayat",sid,{bacaan:[],hafalan:[]});
    showToast("Data santri ditambahkan");
  }
  closeModal();
}

async function hapusSantri(id){
  const s=findSantri(id);
  if(!s||!confirm("Hapus data santri ini?"))return;
  await fbDelete("santri",id);
  if(s.waliId)await fbDelete("wali",s.waliId);
  await fbDelete("keuangan",id);
  await fbDelete("riwayat",id);
  showToast("Data santri dihapus");
}

