/* ============================================================
   HELPERS
   ============================================================ */
function rupiah(n){ return 'Rp' + n.toLocaleString('id-ID'); }
function tglIndo(iso){
  if(!iso || iso==='-') return '-';
  const bln=['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
  const d=new Date(iso+'T00:00:00');
  return d.getDate()+' '+bln[d.getMonth()]+' '+d.getFullYear();
}
function initials(name){ return name.split(' ').filter(w=>!/^(bpk\.|ibu)$/i.test(w)).slice(0,2).map(w=>w[0]).join('').toUpperCase(); }
function findSantri(id){ return DB.santri.find(s=>s.id===id); }
function findJilid(id){ return DB.jilid.find(j=>j.id===id); }
function findUstadzah(id){ return DB.ustadzah.find(u=>u.id===id); }
function findWali(id){ return DB.wali.find(w=>w.id===id); }
function applyBranding(){
  const badge = document.getElementById('login-badge-el');
  const mark = document.getElementById('topbar-mark-el');
  const inner = DB.settings.logo ? `<img src="${DB.settings.logo}" alt="Logo TPQ Wardatul Wathon" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">` : 'TW';
  if(badge) badge.innerHTML = inner;
  if(mark) mark.innerHTML = inner;
}
function showToast(msg){
  const t=document.getElementById('toast');
  document.getElementById('toast-text').textContent=msg;
  t.classList.add('show');
  clearTimeout(window._toastTimer);
  window._toastTimer=setTimeout(()=>t.classList.remove('show'),2600);
}
function openModal(html, wide){
  document.getElementById('modal-box').className = 'modal-box' + (wide?' wide':'');
  document.getElementById('modal-box').innerHTML = html;
  document.getElementById('modal-backdrop').classList.add('open');
}
function closeModal(){
  document.getElementById('modal-backdrop').classList.remove('open');
  if(ui.recordTimer){ clearInterval(ui.recordTimer); ui.recordTimer=null; }
  ui.recording=false; ui.recordSeconds=0;
}
document.getElementById('modal-backdrop').addEventListener('click', function(e){
  if(e.target===this) closeModal();
});
document.addEventListener('keydown', function(e){
  if(e.key==='Escape' && document.getElementById('modal-backdrop').classList.contains('open')) closeModal();
});

