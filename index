async function tambahIuranSetting(){
  openModal(`<div class="modal-head"><div><h3>Tambah iuran kegiatan</h3></div><button class="modal-close" onclick="closeModal()"><i class="fa-solid fa-xmark"></i></button></div><div class="modal-body"><div class="form-row"><label>Nama kegiatan</label><input id="f-iuran-nama"></div><div class="form-row"><label>Nominal</label><input type="number" id="f-iuran-nominal"></div><div class="form-row"><label>Batas waktu</label><input type="date" id="f-iuran-deadline"></div></div><div class="modal-foot"><button class="btn btn-ghost" onclick="closeModal()">Batal</button><button class="btn btn-primary" onclick="simpanIuranSetting()">Simpan</button></div>`);
}

async function simpanIuranSetting(){
  const nama=$("f-iuran-nama").value.trim();
  const nominal=parseInt($("f-iuran-nominal").value)||0;
  const deadline=$("f-iuran-deadline").value||fbDate();
  if(!nama){showToast("Nama iuran wajib diisi");return}
  const settings={...DB.settings,iuran:[...(DB.settings.iuran||[]),{id:fbId(),nama,nominal,deadline}]};
  await fbWrite("settings","main",{iuran:settings.iuran});
  const batch=fbDb.batch();
  DB.santri.forEach(s=>{
    const list=[...(DB.keuangan[s.id]||[])];
    list.push({id:fbId(),jenis:"Iuran",label:nama,nominal,status:"belum",metode:"-",tanggal:"-"});
    batch.set(fbDb.collection("keuangan").doc(s.id),{items:list,updatedAt:firebase.firestore.FieldValue.serverTimestamp()},{merge:true});
  });
  await batch.commit();
  closeModal();
  showToast("Iuran dibuat dan ditambahkan ke santri");
}

async function hapusIuranSetting(id){
  const list=(DB.settings.iuran||[]).filter(x=>x.id!==id);
  await fbWrite("settings","main",{iuran:list});
  showToast("Iuran dihapus dari pengaturan");
}

async function bootstrapFirebase(){
  if(!firebaseConfigured()){
    fbShowLogin();
    return;
  }
  try{
    fbApp=firebase.initializeApp(FIREBASE_CONFIG);
    fbAuth=firebase.auth();
    fbDb=firebase.firestore();
    fbStorage=firebase.storage();
    fbReady=true;
    fbAuth.onAuthStateChanged(async user=>{
      if(user){
        try{
          const profile=await fbProfile(user.uid);
          fbSetSession(profile);
          fbStartRealtime();
          fbRefresh();
        }catch(e){
          console.error(e);
          await fbAuth.signOut();
          fbShowLogin();
        }
      }else{
        fbShowLogin();
      }
      fbShowLogin();
    });
  }catch(e){
    console.error(e);
    fbShowLogin();
    showLoginError("Firebase gagal diinisialisasi: "+e.message);
  }
}

