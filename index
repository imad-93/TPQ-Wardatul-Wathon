      <div class="pv-note">Terakhir dibuka — pertemuan berikutnya otomatis membuka halaman ini</div>
    </div>

    <div class="two-col" style="margin-bottom:14px;">
      <div class="form-row" style="margin-bottom:0;">
        <label>Tandai halaman ini</label>
        <input type="number" id="halaman-input" value="${last.halaman}" min="1">
      </div>
      <div class="form-row" style="margin-bottom:0;display:flex;flex-direction:column;">
        <label>&nbsp;</label>
        <button class="btn btn-primary" style="width:100%;" onclick="markHalaman('${santriId}','${jenis}')"><i class="fa-solid fa-bookmark"></i> Simpan halaman</button>
      </div>
    </div>

    <div class="two-col" style="margin-bottom:16px;">
      <button class="btn btn-ghost" onclick="addRiwayat('${santriId}','${jenis}','naik')"><i class="fa-solid fa-arrow-up"></i> Tandai naik</button>
      <button class="btn btn-ghost" onclick="addRiwayat('${santriId}','${jenis}','mengulang')"><i class="fa-solid fa-rotate-left"></i> Tandai mengulang</button>
    </div>

    <div class="form-row">
      <label>Pesan untuk wali santri</label>
      <textarea id="pesan-teks" placeholder="Tuliskan catatan singkat untuk wali santri..."></textarea>
    </div>
    <div class="mic-box">
      <button class="mic-circle ${ui.recording?'recording':''}" id="mic-btn" onclick="toggleRecording('${santriId}','${jenis}')"><i class="fa-solid ${ui.recording?'fa-stop':'fa-microphone'}"></i></button>
      <div class="wave" id="mic-wave">${wavebars()}</div>
      <div class="mic-time" id="mic-time">${fmtTime(ui.recordSeconds)}</div>
    </div>
    <button class="btn btn-gold" style="width:100%;margin-bottom:18px;" onclick="sendPesan('${santriId}','${jenis}')"><i class="fa-solid fa-paper-plane"></i> Kirim pesan ke wali</button>

    <div class="panel-head" style="margin-bottom:8px;"><h3 style="font-size:14px;">Riwayat</h3></div>
    <div class="table-scroll">
    <table>
      <thead><tr><th>No.</th><th>Halaman</th><th>Status</th><th>Pesan</th><th>Tanggal</th></tr></thead>
      <tbody>
        ${list.length===0 ? `<tr><td colspan="5"><div class="empty-note">Belum ada riwayat.</div></td></tr>` :
        list.map((r,i)=>`
          <tr>
            <td>${i+1}</td>
            <td>Hal. ${r.halaman}</td>
            <td>${r.status==='naik' ? '<span class="badge badge-green">Naik</span>' : '<span class="badge badge-brick">Mengulang</span>'}</td>
            <td>${r.pesanTipe==='suara' ? `<div class="voice-msg"><button class="vm-play" onclick="showToast('Memutar pesan suara (simulasi)')"><i class="fa-solid fa-play"></i></button>${r.pesan}</div>` : (r.pesan||'—')}</td>
            <td style="white-space:nowrap;font-size:12px;color:var(--ink-faint);">${tglIndo(r.tanggal)}</td>
          </tr>`).join('')}
      </tbody>
    </table>
    </div>
  `;
}
function wavebars(){
  let h=[8,14,20,12,24,10,18,9,16,22,11,7];
  return h.map(v=>`<span style="height:${v}px;"></span>`).join('');
}
function fmtTime(s){ const m=Math.floor(s/60); const ss=s%60; return m+':'+String(ss).padStart(2,'0'); }

function refreshBookModal(santriId, jenis){
  const santri = findSantri(santriId);
  const jilid = findJilid(santri.jilidId);
  const buku = jenis==='bacaan' ? jilid.bukuBacaan : jilid.bukuHafalan;
  const list = DB.riwayat[santriId][jenis];
  const last = list[0] || { halaman:1, status:'naik' };
  document.getElementById('book-modal-body').innerHTML = renderBookModalBody(santriId, jenis, buku, last, list);
}

function markHalaman(santriId, jenis){
  const val = parseInt(document.getElementById('halaman-input').value)||1;
  if(!DB.riwayat[santriId]) DB.riwayat[santriId]={bacaan:[],hafalan:[]};
  DB.riwayat[santriId][jenis].unshift({ halaman:val, status:'naik', pesan:'Halaman ditandai oleh ustadzah.', pesanTipe:'teks', tanggal:new Date().toISOString().slice(0,10) });
  showToast('Halaman terakhir tersimpan — pertemuan berikutnya otomatis dibuka di halaman ini');
  refreshBookModal(santriId, jenis);
}
function addRiwayat(santriId, jenis, status){
  const list = DB.riwayat[santriId][jenis];
  const last = list[0] || { halaman:1 };
  list.unshift({ halaman:last.halaman, status, pesan: status==='naik' ? 'Alhamdulillah, bacaan sudah baik.' : 'Perlu diulang, latihan sedikit lagi ya.', pesanTipe:'teks', tanggal:new Date().toISOString().slice(0,10) });
  showToast(status==='naik' ? 'Ditandai naik' : 'Ditandai mengulang');
  refreshBookModal(santriId, jenis);
}
function toggleRecording(santriId, jenis){
  ui.recording = !ui.recording;
  if(ui.recording){
    ui.recordSeconds = 0;
    ui.recordTimer = setInterval(()=>{
      ui.recordSeconds++;
      const mt=document.getElementById('mic-time'); if(mt) mt.textContent=fmtTime(ui.recordSeconds);
      const wv=document.getElementById('mic-wave'); if(wv){ [...wv.children].forEach(b=>b.style.height=(6+Math.random()*20)+'px'); }
    },350);
    showToast('Merekam pesan suara...');
  } else {
    clearInterval(ui.recordTimer); ui.recordTimer=null;
    showToast('Rekaman selesai — tekan "Kirim pesan ke wali" untuk mengirim');
  }
  refreshBookModal(santriId, jenis);
}
function sendPesan(santriId, jenis){
  const teks = document.getElementById('pesan-teks').value.trim();
  const list = DB.riwayat[santriId][jenis];
  const last = list[0] || { halaman:1, status:'naik' };
  if(ui.recordSeconds>0){
    list.unshift({ halaman:last.halaman, status:last.status||'naik', pesan:`Pesan suara (${fmtTime(ui.recordSeconds)})`, pesanTipe:'suara', tanggal:new Date().toISOString().slice(0,10) });
  } else if(teks){
    list.unshift({ halaman:last.halaman, status:last.status||'naik', pesan:teks, pesanTipe:'teks', tanggal:new Date().toISOString().slice(0,10) });
  } else {
    showToast('Tulis pesan atau rekam pesan suara terlebih dahulu'); return;
  }
  ui.recording=false; ui.recordSeconds=0; clearInterval(ui.recordTimer); ui.recordTimer=null;
  showToast('Pesan terkirim ke wali santri');
  refreshBookModal(santriId, jenis);
}

