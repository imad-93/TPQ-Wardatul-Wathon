function renderFinanceModalBody(santriId){
  const santri = findSantri(santriId);
  if(!DB.keuangan[santriId]) DB.keuangan[santriId]=[];
  const all = DB.keuangan[santriId];
  const tab = ui.financeTab;
  const filtered = all.filter(k=>k.jenis===tab);

  let extra='';
  if(tab==='SPP'){
    extra = `<p style="font-size:12px;color:var(--ink-faint);margin-bottom:12px;">Nominal SPP: ${rupiah(DB.settings.spp.nominal)} · jatuh tempo tanggal ${DB.settings.spp.jatuhTempo} tiap bulan (diatur admin).</p>`;
  } else if(tab==='Tabungan'){
    extra = `<p style="font-size:12px;color:var(--ink-faint);margin-bottom:12px;">Minimal setoran ${rupiah(DB.settings.tabungan.minSetor)}/bulan. ${DB.settings.tabungan.keterangan}</p>`;
  } else {
    extra = `<p style="font-size:12px;color:var(--ink-faint);margin-bottom:12px;">Daftar iuran kegiatan aktif diatur oleh admin.</p>`;
  }

  return `
    <div class="tabs">
      <button class="tab-btn ${tab==='SPP'?'active':''}" onclick="setFinanceTab('${santriId}','SPP')">SPP</button>
      <button class="tab-btn ${tab==='Tabungan'?'active':''}" onclick="setFinanceTab('${santriId}','Tabungan')">Tabungan</button>
      <button class="tab-btn ${tab==='Iuran'?'active':''}" onclick="setFinanceTab('${santriId}','Iuran')">Iuran kegiatan</button>
    </div>
    ${extra}
    <div class="table-scroll">
    <table>
      <thead><tr><th>Label</th><th>Nominal</th><th>Status</th><th>Aksi</th></tr></thead>
      <tbody>
        ${filtered.length===0 ? `<tr><td colspan="4"><div class="empty-note">Belum ada catatan.</div></td></tr>` :
        filtered.map(k=>`
          <tr>
            <td>${k.label}</td>
            <td>${rupiah(k.nominal)}</td>
            <td>${k.status==='lunas' ? `<span class="badge badge-green">Lunas · ${tglIndo(k.tanggal)}</span>` : `<span class="badge badge-brick">Belum lunas</span>`}</td>
            <td>${k.status==='lunas' ? `<span style="font-size:12px;color:var(--ink-faint);">via ${k.metode}</span>` : `<button class="btn btn-ghost btn-sm" onclick="markLunas('${santriId}','${k.id}')">Tandai lunas (tunai)</button>`}</td>
          </tr>`).join('')}
      </tbody>
    </table>
    </div>
    ${tab==='Tabungan' ? `<button class="btn btn-gold" style="margin-top:14px;" onclick="tambahSetoran('${santriId}')"><i class="fa-solid fa-plus"></i> Catat setoran tabungan baru</button>` : ''}
  `;
}
function setFinanceTab(santriId, tab){ ui.financeTab=tab; document.getElementById('finance-modal-body').innerHTML = renderFinanceModalBody(santriId); }
function markLunas(santriId, kId){
  const item = DB.keuangan[santriId].find(k=>k.id===kId);
  item.status='lunas'; item.metode='Tunai'; item.tanggal=new Date().toISOString().slice(0,10);
  showToast('Ditandai lunas (tunai)');
  document.getElementById('finance-modal-body').innerHTML = renderFinanceModalBody(santriId);
}
function tambahSetoran(santriId){
  const bulan=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
  const d=new Date();
  const id='k'+Math.random().toString(36).slice(2,7);
  DB.keuangan[santriId].push({ id, jenis:'Tabungan', label:`Tabungan ${bulan[d.getMonth()]} ${d.getFullYear()}`, nominal:DB.settings.tabungan.minSetor, status:'belum', metode:'-', tanggal:'-' });
  showToast('Tagihan tabungan baru ditambahkan');
  document.getElementById('finance-modal-body').innerHTML = renderFinanceModalBody(santriId);
}

