    <div class="modal-foot">
      <button class="btn btn-ghost" onclick="closeModal()">Batal</button>
      <button class="btn btn-primary" onclick="simpanSantri('${id||''}')">Simpan</button>
    </div>
  `);
}
function simpanSantri(id){
  const nama = document.getElementById('f-nama').value.trim();
  const jilidId = document.getElementById('f-jilid').value;
  const waliNama = document.getElementById('f-wali-nama').value.trim();
  const waliHp = document.getElementById('f-wali-hp').value.trim();
  if(!nama || !waliNama){ showToast('Nama santri dan wali wajib diisi'); return; }

  if(id){
    const s = findSantri(id); s.nama=nama; s.jilidId=jilidId;
    const w = findWali(s.waliId); w.nama=waliNama; w.hp=waliHp;
    showToast('Data santri diperbarui');
  } else {
    const newSantriId = 's'+Math.random().toString(36).slice(2,7);
    const newWaliId = 'w'+Math.random().toString(36).slice(2,7);
    const usernameEl = document.getElementById('f-wali-username');
    const uname = (usernameEl && usernameEl.value.trim()) || ('wali.'+nama.split(' ')[0].toLowerCase());
    DB.wali.push({ id:newWaliId, nama:waliNama, username:uname, hp:waliHp, santriId:newSantriId });
    DB.santri.push({ id:newSantriId, nama, jilidId, waliId:newWaliId });
    DB.keuangan[newSantriId]=[]; DB.riwayat[newSantriId]={bacaan:[],hafalan:[]};
    showToast('Santri baru ditambahkan — akun wali "'+uname+'" siap diunduh');
  }
  closeModal(); renderAdminSantri();
}
function hapusSantri(id){
  const s = findSantri(id);
  DB.santri = DB.santri.filter(x=>x.id!==id);
  DB.wali = DB.wali.filter(w=>w.id!==s.waliId);
  showToast('Data santri dihapus');
  renderAdminSantri();
}

